[ext_resource type="Texture2D" path="res://assets/vfx/free_magic/T_Free_Magic_Noise1.PNG" id="3_noise"]

[sub_resource type="Shader" id="Shader_circle"]
code = "shader_type spatial;\nrender_mode unshaded, cull_disabled, blend_add, depth_draw_never;\nuniform sampler2D circle_tex : source_color;\nuniform vec4 tint : source_color = vec4(0.45, 1.0, 0.28, 1.0);\nuniform float emission_strength = 1.6;\nvoid fragment(){\n    vec4 tex = texture(circle_tex, UV);\n    ALBEDO = tint.rgb;\n    EMISSION = tint.rgb * tex.rgb * emission_strength;\n    ALPHA = tex.a * tint.a;\n}\n"

[sub_resource type="ShaderMaterial" id="Material_circle"]
shader = SubResource("Shader_circle")
shader_parameter/circle_tex = ExtResource("2_circle")
shader_parameter/tint = Color(0.45, 1, 0.28, 1)
shader_parameter/emission_strength = 1.25

[sub_resource type="Shader" id="Shader_glow"]
code = "shader_type spatial;\nrender_mode unshaded, cull_disabled, blend_add, depth_draw_never;\nuniform sampler2D noise_tex : source_color;\nuniform vec4 tint : source_color = vec4(0.35, 1.0, 0.18, 1.0);\nuniform float emission_strength = 0.35;\nvoid fragment(){\n    vec2 uv = UV * 1.4;\n    vec4 tex = texture(noise_tex, uv);\n    float mask = smoothstep(0.05, 0.65, tex.r) * 0.22;\n    ALBEDO = tint.rgb;\n    EMISSION = tint.rgb * mask * emission_strength;\n    ALPHA = mask;\n}\n"

[sub_resource type="ShaderMaterial" id="Material_glow"]
shader = SubResource("Shader_glow")
shader_parameter/noise_tex = ExtResource("3_noise")
shader_parameter/tint = Color(0.45, 1, 0.28, 1)
shader_parameter/emission_strength = 0.8

